{
	email {$ACME_EMAIL}
	admin off
}

https://{$CRM_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Canonical setup URL. Caddy terminates TLS and strips /setup before
	# forwarding to the wizard's internal port.
	redir /setup /setup/ 308

	handle_path /setup/* {
		reverse_proxy wizard:8787
	}

	# n8n UI, public API, OAuth callbacks and webhooks share the same origin.
	handle {
		reverse_proxy n8n:5678
	}
}
