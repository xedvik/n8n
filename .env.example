# Single deployment profile. Copy to .env and replace CHANGE_ME values.
# Never commit the real .env file. Caddy, n8n, PostgreSQL and Wizard run in one stack.

# --- Public ingress ---
# The only public address. DNS must point to this host.
CRM_DOMAIN=CHANGE_ME_DOMAIN
ACME_EMAIL=CHANGE_ME_EMAIL

# --- PostgreSQL (internal only; no host port) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- n8n (internal only; reached through Caddy) ---
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
N8N_HOST=CHANGE_ME_DOMAIN
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://CHANGE_ME_DOMAIN/
N8N_EDITOR_BASE_URL=https://CHANGE_ME_DOMAIN/
N8N_PROXY_HOPS=1
N8N_API_URL=http://n8n:5678
N8N_PUBLIC_URL=https://CHANGE_ME_DOMAIN/

# --- Unified setup wizard (internal only; served at /setup/) ---
# Compose sets these values for the wizard service. They are kept here for
# host-side development and emergency scripts; the unified stack is authoritative.
WIZARD_SERVER_MODE=1
WIZARD_HOST=0.0.0.0
WIZARD_PORT=8787
WIZARD_ALLOW_REMOTE=1
WIZARD_TRUST_PROXY=1
WIZARD_ALLOWED_HOSTS=CHANGE_ME_DOMAIN
WIZARD_COOKIE_SECURE=1
WIZARD_COOKIE_PATH=/setup
WIZARD_DATA_DIR=/data
WIZARD_CONFIG_FILE=/app/config/client.json
WIZARD_CONFIG_UID=0
WIZARD_CONFIG_GID=0
WIZARD_SECRET_KEY=CHANGE_ME_64_HEX_CHARS

# Used by the existing doctor/import/migrate scripts inside the wizard container.
BASE_URL=http://n8n:5678
WORKFLOW_ID=7c9f5a2e-3b4d-4f6a-9c1e-2d8b7a6f5e40
COMPOSE_PROJECT_NAME=crm-automation-kit

# --- Runtime ---
GENERIC_TIMEZONE=UTC
TZ=UTC
N8N_LOG_LEVEL=info
LEAD_WEBHOOK_HEADER_NAME=X-Webhook-Secret
LEAD_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET
LEAD_CONFIG_FILE=/app/config/client.json

# --- PII retention for n8n executions ---
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000
