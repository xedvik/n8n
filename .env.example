# Copy this file to .env and replace every value marked CHANGE_ME.
# Never commit the real .env file.

# --- PostgreSQL (internal n8n database) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- n8n ---
# Generate once and keep it stable. Changing it makes stored credentials unreadable:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

N8N_HOST=localhost
N8N_PORT=5678
N8N_BIND_ADDRESS=127.0.0.1
N8N_PROTOCOL=http
# Public base URL used in webhook URLs. Change it when deploying behind a proxy/domain.
N8N_WEBHOOK_URL=http://localhost:5678/
# Public editor URL. Use https://<domain>/ on a server deployment.
N8N_EDITOR_BASE_URL=http://localhost:5678/
# Trusted reverse-proxy hops. 0 locally, 1 behind the bundled Caddy overlay.
N8N_PROXY_HOPS=0

# --- Server deployment (Caddy) ---
# Set these only for a public server install; the local defaults below are safe.
CRM_DOMAIN=CHANGE_ME_DOMAIN
ACME_EMAIL=CHANGE_ME_EMAIL
N8N_API_URL=http://127.0.0.1:5678
N8N_PUBLIC_URL=http://localhost:5678/

# --- Setup wizard ---
WIZARD_SERVER_MODE=0
WIZARD_HOST=127.0.0.1
WIZARD_PORT=8787
WIZARD_ALLOWED_HOSTS=localhost,127.0.0.1
WIZARD_COOKIE_SECURE=0
WIZARD_COOKIE_PATH=/
WIZARD_DATA_DIR=./wizard-data
# Generated automatically by scripts/install-server.sh in server mode.
# Local mode does not use wizard auth, so it can stay empty.
WIZARD_SECRET_KEY=

# --- Runtime ---
GENERIC_TIMEZONE=UTC
TZ=UTC
N8N_LOG_LEVEL=info

# --- Lead intake configuration ---
# The n8n container mounts the whole ./config directory read-only and always
# reads ./config/client.json. setup-client.sh writes that file.
# This variable is used by host-side helper scripts.
LEAD_CONFIG_FILE=./config/client.json

# Shared secret for the n8n Header Auth credential on Lead Webhook.
# Create the credential in n8n with header name X-Webhook-Secret and this value.
LEAD_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET

# --- PII retention for n8n executions ---
# 168 hours = 7 days. Keep this aligned with your client's privacy policy.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000
